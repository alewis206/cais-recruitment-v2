# Anthropic API key for event scoring (Claude Haiku 4.5)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AgentMail API key for sending the Monday digest
# Get one at: https://agentmail.to/ (Settings → API Keys)
AGENTMAIL_API_KEY=

# AgentMail inbox the digest is sent FROM. Create at agentmail.to.
# Default form: digest@agentmail.to (no DNS setup needed).
# Or use a custom domain you've verified inside AgentMail: digest@customaistudio.io
AGENTMAIL_INBOX=digest@agentmail.to

# Comma-separated recipient list for the Monday digest
DIGEST_TO=andrew@customaistudio.io

# Public URL where the dashboard is deployed (for the email "Open dashboard" link)
DASHBOARD_URL=https://cais-recruitment.vercel.app

# Optional: skip the LLM scoring step and use rule-based scoring only.
# Useful for local dev without an Anthropic key. Set to "1" to enable.
SCORING_RULES_ONLY=
