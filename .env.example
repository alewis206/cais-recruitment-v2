# Anthropic API key for event scoring (Claude Haiku 4.5)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend API key for sending the Monday digest
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=

# From-address for the digest email. Must be on a domain you've verified in Resend.
# For testing you can use: onboarding@resend.dev
DIGEST_FROM=digest@example.com

# Comma-separated recipient list for the Monday digest
DIGEST_TO=andrew@customaistudio.io

# Public URL where the dashboard is deployed (for email "Open dashboard" link)
DASHBOARD_URL=https://cais-recruitment.vercel.app

# Optional: skip the LLM scoring step and use rule-based scoring only
# Useful for local dev without an API key. Set to "1" to enable.
SCORING_RULES_ONLY=
